# Copy to .env and edit. Every variable is optional -- the defaults run fine.
# All settings use the AVS_ prefix (see app/core/config.py).

# --- Optional LLM for natural-language requests ------------------------------
# The chat agent tries a model first, then falls back to its rule-based parser.
# The app is fully functional with no model at all; this only improves how well
# free-form sentences are understood.
#
# Free local option (recommended) -- https://ollama.com
#   ollama pull llama3.2 && ollama serve
AVS_LLM_ENABLED=true
AVS_LLM_BASE_URL=http://127.0.0.1:11434/v1
AVS_LLM_MODEL=llama3.2
AVS_LLM_API_KEY=ollama
AVS_LLM_TIMEOUT_SECONDS=10

# Any OpenAI-compatible gateway works instead, e.g.:
#   AVS_LLM_BASE_URL=https://api.groq.com/openai/v1
#   AVS_LLM_MODEL=llama-3.1-8b-instant
#   AVS_LLM_API_KEY=your-key-here

# --- Upload limits -----------------------------------------------------------
AVS_MAX_UPLOAD_SIZE_MB=12
AVS_MAX_PIXELS=40000000

# --- HTTP --------------------------------------------------------------------
# Comma-separated origins. "*" suits a public read-only demo.
AVS_CORS_ALLOW_ORIGINS=*

# --- Storage -----------------------------------------------------------------
# Only used by the CLI; the HTTP API keeps everything in memory.
# AVS_WORKSPACE_DIR=/tmp/agentic-vision-studio
